
@article{stroop_studies_1935,
	location = {{US}},
	title = {Studies of interference in serial verbal reactions},
	volume = {18},
	issn = {0022-1015},
	doi = {10.1037/h0054651},
	abstract = {In this study pairs of conflicting stimuli, both being inherent aspects of the same symbols, were presented simultaneously (a name of one color printed in the ink of another color—a word stimulus and a color stimulus). The difference in time for reading the words printed in colors and the same words printed in black is the measure of the interference of color stimuli upon reading words. The difference in the time for naming the colors in which the words are printed and the same colors printed in squares (or swastikas) is the measure of the interference of conflicting word stimuli upon naming colors. The interference of conflicting color stimuli upon the time for reading 100 words (each word naming a color unlike the ink-color of its print) caused an increase of 2.3 seconds or 5.6\% over the normal time for reading the same words printed in black. This increase is not reliable. But the interference of conflicting word stimuli upon the time for naming 100 colors (each color being the print of a word which names another color) caused an increase of 47.0 seconds or 74.3\% of the normal time for naming colors printed in squares. Tests on the permanency of the interference of conflicting word stimuli are also described. ({PsycInfo} Database Record (c) 2025 {APA}, all rights reserved)},
	pages = {643--662},
	number = {6},
	journaltitle = {Journal of Experimental Psychology},
	publisher = {Psychological Review Company},
	author = {Stroop, J. R.},
	date = {1935},
	keywords = {Color, Interference (Learning), Words (Phonetic Units)},
	file = {Submitted Version:C\:\\Users\\kmitc\\Zotero\\storage\\TXF6NJH7\\Stroop - 1935 - Studies of interference in serial verbal reactions.pdf:application/pdf},
}

@article{sutton_automatic_2007,
	location = {United Kingdom},
	title = {The automatic access of emotion: Emotional stroop effects in Spanish-English bilingual speakers},
	volume = {21},
	issn = {1464-0600},
	doi = {10.1080/02699930601054133},
	shorttitle = {The automatic access of emotion},
	abstract = {The emotional Stroop task provides an experimental measure of selective attention to emotional information. In the current study, the emotional Stroop effect was examined in a Spanish-English bilingual speaking population. The results revealed that the emotional Stroop effect is a robust phenomenon and replicable within a bilingual population. Furthermore, highly proficient bilinguals demonstrated equal interference effects in both their first language and their second language. The current study provides evidence of the automatic activation of emotional components in words appearing in more than one language. These results are discussed with reference to previous findings in the literature on bilingual emotion word representation. ({PsycINFO} Database Record (c) 2016 {APA}, all rights reserved)},
	pages = {1077--1090},
	number = {5},
	journaltitle = {Cognition and Emotion},
	publisher = {Taylor \& Francis},
	author = {Sutton, Tina M. and Altarriba, Jeanette and Gianico, Jennifer L. and Basnight-Brown, Dana M.},
	date = {2007},
	keywords = {Bilingualism, Emotions, Interference (Learning), Selective Attention, Stroop Effect},
	file = {Snapshot:C\:\\Users\\kmitc\\Zotero\\storage\\33J45ZN6\\2007-11502-009.html:text/html},
}

