@article{magiste_stroop_1984,
	location = {{US}},
	title = {Stroop tasks and dichotic translation: The development of interference patterns in bilinguals},
	volume = {10},
	issn = {1939-1285},
	doi = {10.1037/0278-7393.10.2.304},
	shorttitle = {Stroop tasks and dichotic translation},
	abstract = {Developmental changes in intra- and interlingual interference were followed in 114 German–Swedish bilingual high school students using Stroop tasks in the visual modality and dichotic translation of concrete and abstract sentences in the auditory modality. Results across modalities provide evidence that the pattern of interference was mainly determined by language proficiency. Intra- and interlingual interference followed language dominance patterns in an ever-changing process; hence, it was the point of measurement that determined whether equivalent or differing amounts of interference were obtained between languages. German-dominant Ss experienced more Stroop interference from German words when responding in both German and Swedish; for Swedish-dominant Ss, Swedish words caused more interference. Equivalent amounts of interference occurred at stages of language balance. In dichotic translation, Ss made more errors when information on the interfering channel was in the dominant language. Findings reveal parallels between interference in the natural context studied by linguists and experimentally induced interference studied mainly by psychologists. (25 ref) ({PsycInfo} Database Record (c) 2025 {APA}, all rights reserved)},
	pages = {304--315},
	number = {2},
	journaltitle = {Journal of Experimental Psychology: Learning, Memory, and Cognition},
	publisher = {American Psychological Association},
	author = {Mägiste, Edith},
	date = {1984},
	keywords = {Interference (Learning), Bilingualism, Foreign Language Learning, Stroop Color Word Test},
	file = {Snapshot:C\:\\Users\\kmitc\\Zotero\\storage\\8U6NI2YH\\1985-06307-001.html:text/html},
}

